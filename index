<style>

/* ============ TOKENS ============ */
:root{
  --azul: #092C54;
  --azul-2: #0E3D70;
  --amarillo: #FFD54F;
  --verde: #61A624;
  --verde-dark: #4C8A1A;
  --bg: #FFFFFF;
  --bg-alt: #F4F6F9;
  --text: #1E2229;
  --text-soft: #4B5563;
  --line: #E3E8EF;
  --radius: 10px;
  --max: 1180px;
  --shadow: 0 12px 32px -12px rgba(9,44,84,0.18);
  --font-display: 'Space Grotesk', sans-serif;
  --font-body: 'IBM Plex Sans', sans-serif;
  --font-mono: 'IBM Plex Mono', monospace;
}

*{box-sizing:border-box; margin:0; padding:0;}
html{scroll-behavior:smooth;}
body{
  font-family: var(--font-body);
  color: var(--text);
  background: var(--bg);
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
img{max-width:100%; display:block;}
a{text-decoration:none; color:inherit;}
ul{list-style:none;}
.img-responsive{
  width:100%; height:auto; border-radius: var(--radius); box-shadow: var(--shadow);
  background:#fff; padding:18px; box-sizing:border-box; object-fit:contain;
}
section{position:relative;}
.wrap{max-width:var(--max); margin:0 auto; padding:0 24px;}
h1,h2,h3,h4{font-family:var(--font-display); font-weight:700; letter-spacing:-0.01em; color:var(--azul);}
.eyebrow{
  font-family:var(--font-mono); font-size:12.5px; letter-spacing:0.14em; text-transform:uppercase;
  color:var(--verde-dark); font-weight:600; display:inline-flex; align-items:center; gap:8px; margin-bottom:14px;
}
.eyebrow::before{content:""; width:22px; height:2px; background:var(--verde); display:inline-block;}
.section-head{max-width:640px; margin-bottom:44px;}
.section-head h2{font-size:clamp(1.6rem, 3.2vw, 2.3rem); margin-bottom:14px;}
.section-head p{color:var(--text-soft); font-size:1.05rem;}
.section-pad{padding: 88px 0;}
@media (max-width:720px){ .section-pad{padding:56px 0;} }

/* focus visibility */
a:focus-visible, button:focus-visible, summary:focus-visible{
  outline:3px solid var(--verde); outline-offset:3px; border-radius:4px;
}
@media (prefers-reduced-motion: reduce){
  *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; scroll-behavior:auto !important;}
}

/* ============ BUTTONS (image-based) ============ */
.btn-img{display:inline-block; transition:transform .18s ease, filter .18s ease;}
.btn-img:hover{transform:translateY(-2px);}
.btn-img img{height:88px; width:auto;}
.btn-row{display:flex; flex-wrap:wrap; gap:20px; align-items:center;}
@media (max-width:480px){ .btn-img img{height:64px;} }

/* ============ HEADER ============ */
header.site{
  position:sticky; top:0; z-index:100; background:rgba(255,255,255,0.92);
  backdrop-filter:blur(10px); border-bottom:1px solid var(--line);
}
.nav-inner{display:flex; align-items:center; justify-content:space-between; padding:10px 24px; max-width:var(--max); margin:0 auto;}
.nav-links{display:flex; gap:32px; font-size:0.95rem; font-weight:500;}
.nav-links a{position:relative; padding:4px 0; color:var(--text);}
.nav-links a::after{content:""; position:absolute; left:0; bottom:0; width:0; height:2px; background:var(--verde); transition:width .2s ease;}
.nav-links a:hover::after{width:100%;}
.nav-cta{display:flex; align-items:center; gap:18px;}
.nav-cta .btn-img img{height:64px;}
.burger{display:none; flex-direction:column; gap:5px; background:none; border:none; cursor:pointer; padding:8px;}
.burger span{width:24px; height:2px; background:var(--azul); display:block;}
@media (max-width:900px){
  .nav-links{position:fixed; top:96px; left:0; right:0; background:#fff; flex-direction:column; gap:0;
    box-shadow:var(--shadow); max-height:0; overflow:hidden; transition:max-height .3s ease; border-bottom:1px solid var(--line);}
  .nav-links.open{max-height:400px;}
  .nav-links a{padding:16px 24px; border-bottom:1px solid var(--line); width:100%;}
  .burger{display:flex;}
  .nav-cta .btn-img{display:none;}
}

/* ============ HERO ============ */
.hero{
  background:
    repeating-linear-gradient(0deg, rgba(9,44,84,0.05) 0 1px, transparent 1px 44px),
    repeating-linear-gradient(90deg, rgba(9,44,84,0.05) 0 1px, transparent 1px 44px),
    linear-gradient(180deg, #FFFFFF 0%, #F4F6F9 100%);
  padding: 76px 0 56px;
}
.hero-grid{display:grid; grid-template-columns: 1.1fr 0.9fr; gap:56px; align-items:center;}
.hero h1{font-size:clamp(2.05rem, 4.3vw, 3.1rem); line-height:1.1; margin-bottom:20px;}
.hero h1 .accent{color:var(--verde-dark);}
.hero p.lead{font-size:1.1rem; color:var(--text-soft); max-width:540px; margin-bottom:32px;}
.benefit-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:14px; margin-bottom:36px;}
.benefit-item{
  display:flex; gap:10px; align-items:flex-start; font-size:0.92rem; font-weight:500;
  background:#fff; border:1px solid var(--line); border-radius:8px; padding:12px 14px;
}
.benefit-item svg{flex-shrink:0; width:20px; height:20px; margin-top:1px;}
.hero-media{position:relative;}
.hero-media::before{
  content:"PASS"; position:absolute; top:-14px; right:18px; z-index:2;
  font-family:var(--font-mono); font-weight:600; font-size:12px; letter-spacing:0.08em;
  background:var(--verde); color:#fff; padding:6px 12px; border-radius:20px; box-shadow:var(--shadow);
}
@media (max-width:900px){
  .hero-grid{grid-template-columns:1fr;}
  .hero-media{order:-1;}
  .benefit-grid{grid-template-columns:1fr;}
}

/* ============ TAGS (posicionamiento amplio) ============ */
.tagbar{padding: 26px 0 0;}
.tagbar .wrap{display:flex; flex-wrap:wrap; gap:10px; justify-content:center;}
.tag-chip{
  font-family:var(--font-mono); font-size:12px; letter-spacing:0.02em; color:var(--azul);
  background:#fff; border:1px solid var(--line); padding:8px 14px; border-radius:20px;
}

/* ============ TRUST BAR ============ */
.trustbar{background:var(--azul); color:#fff; padding:44px 0;}
.trust-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:28px 24px; text-align:center;}
.trust-item .num{font-family:var(--font-mono); font-size:clamp(1.3rem,2.2vw,1.9rem); font-weight:600; color:#8CD35C;}
.trust-item .label{font-size:0.8rem; color:#C7D4E5; margin-top:6px; letter-spacing:0.02em;}
@media (max-width:700px){ .trust-grid{grid-template-columns:repeat(2,1fr);} }

/* ============ PROBLEMA ============ */
.problema{background:var(--bg-alt);}
.problema-grid{display:grid; grid-template-columns:0.95fr 1.05fr; gap:56px; align-items:center;}
.problema-grid p{color:var(--text-soft); margin-bottom:16px; font-size:1.02rem;}
.problema-grid p strong{color:var(--text);}
@media (max-width:900px){ .problema-grid{grid-template-columns:1fr;} .problema-grid .img-responsive{order:-1;} }

/* blockquote / destacados premium */
blockquote.destacado{
  font-family:var(--font-display); font-weight:600; font-size:clamp(1.15rem,2vw,1.55rem);
  color:var(--azul); line-height:1.4; border-left:4px solid var(--verde);
  background:#fff; padding:26px 28px; border-radius: 0 var(--radius) var(--radius) 0;
  box-shadow:var(--shadow); margin: 32px 0;
}
blockquote.destacado.on-dark{background:rgba(255,255,255,0.06); color:#fff; border-left-color:#8CD35C;}

/* ============ BANDA DE CITA (ancho completo) ============ */
.quote-band{background:var(--azul); padding: 38px 0;}
.quote-band .wrap{max-width:980px;}
.quote-band p{
  font-family:var(--font-display); font-weight:600; color:var(--amarillo);
  font-size:clamp(1.05rem, 2.1vw, 1.45rem); line-height:1.4; text-align:center; margin:0;
}

/* ============ QUÉ VALIDAMOS ============ */
.servicios-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:24px; margin-bottom:36px;}
.banner-servicios{
  width:100%; border-radius:var(--radius); box-shadow:var(--shadow); margin: 0 0 36px;
  background:#fff; padding:20px; box-sizing:border-box; object-fit:contain;
}
.servicios-grid.secundaria{grid-template-columns:repeat(4,1fr);}
.card{
  background:#fff; border:1px solid var(--line); border-radius:var(--radius); padding:28px;
  transition:transform .2s ease, box-shadow .2s ease;
}
.card:hover{transform:translateY(-4px); box-shadow:var(--shadow);}
.card h3{font-size:1.15rem; margin-bottom:10px;}
.card p{color:var(--text-soft); font-size:0.94rem;}
.card .tag{
  display:inline-block; font-family:var(--font-mono); font-size:11px; letter-spacing:0.08em;
  color:var(--verde-dark); background:rgba(97,166,36,0.1); padding:4px 10px; border-radius:20px; margin-bottom:14px;
}
.card ul.mini{margin-top:12px; display:flex; flex-direction:column; gap:6px;}
.card ul.mini li{
  font-size:0.86rem; color:var(--text-soft); display:flex; gap:8px; align-items:flex-start;
}
.card ul.mini li::before{content:""; width:5px; height:5px; border-radius:50%; background:var(--verde); margin-top:7px; flex-shrink:0;}
@media (max-width:900px){ .servicios-grid{grid-template-columns:1fr;} .servicios-grid.secundaria{grid-template-columns:repeat(2,1fr);} }
@media (max-width:520px){ .servicios-grid.secundaria{grid-template-columns:1fr;} }

/* ============ POR QUÉ CERTIFICAR ============ */
.porque{background:var(--bg-alt);}
.porque-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:22px;}
.porque-card{background:#fff; border-radius:var(--radius); padding:26px; border:1px solid var(--line);}
.porque-card svg{width:34px; height:34px; margin-bottom:16px; color:var(--verde-dark);}
.porque-card h3{font-size:1.05rem; margin-bottom:8px;}
.porque-card p{color:var(--text-soft); font-size:0.92rem;}
@media (max-width:900px){ .porque-grid{grid-template-columns:1fr 1fr;} }
@media (max-width:560px){ .porque-grid{grid-template-columns:1fr;} }

/* ============ PROCESO (timeline vertical) ============ */
.timeline-v{max-width:640px; position:relative; padding-left:0;}
.timeline-v::before{content:""; position:absolute; left:19px; top:8px; bottom:8px; width:2px; background:var(--line);}
.tlv-step{position:relative; padding-left:58px; padding-bottom:34px;}
.tlv-step:last-child{padding-bottom:0;}
.tlv-dot{
  position:absolute; left:0; top:0; width:38px; height:38px; border-radius:50%; background:var(--azul); color:#fff;
  display:flex; align-items:center; justify-content:center; font-family:var(--font-mono); font-weight:600; font-size:0.9rem;
  box-shadow:0 0 0 5px #fff; z-index:1;
}
.tlv-step.opcional .tlv-dot{background:#fff; color:var(--azul); border:2px solid var(--line);}
.tlv-step h3{font-size:1.02rem; margin-bottom:4px;}
.tlv-step p{font-size:0.88rem; color:var(--text-soft);}

/* ============ PRUEBAS (con icono) ============ */
.pruebas-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:16px;}
.badge-test{
  background:#fff; border:1px solid var(--line); border-radius:var(--radius); padding:20px 16px;
  transition:transform .2s ease, box-shadow .2s ease;
}
.badge-test:hover{transform:translateY(-3px); box-shadow:var(--shadow);}
.badge-test svg{width:26px; height:26px; color:var(--verde-dark); margin-bottom:12px;}
.badge-test .code{font-family:var(--font-mono); font-weight:600; color:var(--azul); font-size:0.94rem; display:block;}
.badge-test .desc{font-size:0.78rem; color:var(--text-soft); margin-top:6px; display:block;}
@media (max-width:900px){ .pruebas-grid{grid-template-columns:repeat(3,1fr);} }
@media (max-width:600px){ .pruebas-grid{grid-template-columns:repeat(2,1fr);} }

/* ============ EQUIPAMIENTO ============ */
.equipo{background:var(--azul); color:#fff;}
.equipo .eyebrow{color:#8CD35C;}
.equipo h2{color:#fff;}
.equipo-grid{display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:start;}
.equipo-list{margin-top:20px; display:flex; flex-direction:column; gap:12px;}
.equipo-list li{display:flex; gap:12px; align-items:flex-start; font-size:0.94rem; color:#DCE5F0;}
.equipo-list svg{flex-shrink:0; width:19px; height:19px; color:#8CD35C; margin-top:2px;}
@media (max-width:900px){ .equipo-grid{grid-template-columns:1fr;} }

/* ============ ENTREGABLES ============ */
.entregables-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:20px;}
.entregable{text-align:center; padding:26px 16px; background:#fff; border-radius:var(--radius); border:1px solid var(--line);}
.entregable svg{width:30px; height:30px; color:var(--verde-dark); margin-bottom:14px;}
.entregable h3{font-size:0.96rem; margin-bottom:6px;}
.entregable p{font-size:0.82rem; color:var(--text-soft);}
@media (max-width:900px){ .entregables-grid{grid-template-columns:1fr 1fr;} }
@media (max-width:480px){ .entregables-grid{grid-template-columns:1fr;} }

/* ============ DIFERENCIADORES ============ */
.dif{background:var(--bg-alt);}
.dif-grid{display:grid; grid-template-columns:1fr 1fr; gap:36px;}
.dif-col{background:#fff; border-radius:var(--radius); padding:32px; border:1px solid var(--line);}
.dif-col h3{font-size:1.1rem; margin-bottom:18px; display:flex; align-items:center; gap:10px;}
.dif-col ul li{display:flex; gap:10px; padding:10px 0; border-bottom:1px solid var(--line); font-size:0.94rem; color:var(--text-soft);}
.dif-col ul li:last-child{border-bottom:none;}
.dif-col.comercial{border-top:3px solid var(--verde);}
.dif-col.operativo{border-top:3px solid var(--azul);}
.dif-col ul li svg{width:17px; height:17px; color:var(--verde-dark); flex-shrink:0; margin-top:2px;}
@media (max-width:800px){ .dif-grid{grid-template-columns:1fr;} }

/* ============ FAQ ============ */
.faq-list{max-width:760px;}
details.faq-item{
  background:#fff; border:1px solid var(--line); border-radius:8px; margin-bottom:12px; overflow:hidden;
}
details.faq-item summary{
  cursor:pointer; list-style:none; padding:18px 20px; font-weight:600; font-family:var(--font-display);
  display:flex; justify-content:space-between; align-items:center; color:var(--azul); font-size:1rem; gap:16px;
}
details.faq-item summary::-webkit-details-marker{display:none;}
details.faq-item summary::after{content:"+"; font-size:1.4rem; color:var(--verde-dark); font-weight:400; transition:transform .2s ease; flex-shrink:0;}
details.faq-item[open] summary::after{transform:rotate(45deg);}
details.faq-item .faq-a{padding:0 20px 20px; color:var(--text-soft); font-size:0.95rem;}

/* ============ CTA FINAL ============ */
.cta-final{background:var(--azul); color:#fff; text-align:center;}
.cta-final .wrap{max-width:680px;}
.cta-final h2{color:#fff;}
.cta-final p{color:#C7D4E5; margin: 16px 0 32px; font-size:1.05rem;}
.cta-final .btn-row{justify-content:center;}

/* ============ FOOTER ============ */
footer.site{background:#071F3D; color:#B9C6D6; padding:64px 0 28px;}
.footer-grid{display:grid; grid-template-columns:1fr 1fr 1fr; gap:40px; margin-bottom:48px;}
.footer-grid h4{color:#fff; font-family:var(--font-display); font-size:0.95rem; margin-bottom:16px;}
.footer-grid p, .footer-grid a{font-size:0.9rem; color:#9FB3CB; display:block; margin-bottom:8px;}
.footer-grid a:hover{color:#8CD35C;}
.footer-wa{margin-top:8px;}
.footer-wa img{height:46px;}
.footer-brand-img{max-width:280px; margin:0 auto 18px;}
.footer-bottom{text-align:center; border-top:1px solid rgba(255,255,255,0.1); padding-top:24px; font-size:0.82rem; color:#7E93AC;}
@media (max-width:800px){ .footer-grid{grid-template-columns:1fr;} }

/* ============ WHATSAPP FLOTANTE ============ */
.wa-float{
  position:fixed; bottom:22px; right:22px; z-index:200; width:60px; height:60px;
  border-radius:50%; overflow:hidden; box-shadow:0 8px 24px rgba(0,0,0,0.28);
  animation: wa-pulse 2.4s ease-in-out infinite;
}
.wa-float img{width:100%; height:100%; object-fit:contain; background:#fff;}
@keyframes wa-pulse{
  0%,100%{box-shadow:0 8px 24px rgba(0,0,0,0.28);}
  50%{box-shadow:0 8px 24px rgba(97,166,36,0.45);}
}
@media (max-width:480px){ .wa-float{width:52px; height:52px; bottom:16px; right:16px;} }

</style>
</head>
